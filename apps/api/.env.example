# Database
DATABASE_URL="postgresql://user:password@localhost:5432/sena?schema=public"
DATABASE_URL_LOCAL="postgresql://user:password@localhost:5432/sena?schema=public"

# Server
PORT=3000
NODE_ENV=development

# Frontend URLs (for CORS)
FRONTEND_URL=http://localhost:3001
ADMIN_URL=http://localhost:3002

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=1d

# Mail (Nodemailer)
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USER=your-email@example.com
MAIL_PASS=your-email-password
MAIL_FROM="SENA <noreply@sena.edu.co>"