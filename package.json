{
  "name": "sena",
  "version": "1.0.0",
  "private": true,

  "packageManager": "npm@11.9.0",

  "workspaces": [
    "apps/*",
    "apps/gestion/*",
    "packages/*"
  ],

  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",

    "lint": "turbo lint",
    "test": "turbo test",

    "dev:api": "turbo dev --filter=api",
    "dev:web": "turbo dev --filter=web",
    "dev:administrador": "turbo dev --filter=administrador",
    "dev:estudiante": "turbo dev --filter=estudiante",
    "dev:gestion": "turbo dev --filter=estudiante --filter=administrador",

    "build:api": "turbo build --filter=api",
    "build:web": "turbo build --filter=web",
    "build:administrador": "turbo build --filter=administrador",
    "build:estudiante": "turbo build --filter=estudiante",

    "lint:api": "turbo lint --filter=api",
    "lint:web": "turbo lint --filter=web",
    "lint:administrador": "turbo lint --filter=administrador",
    "lint:estudiante": "turbo lint --filter=estudiante"
  },

  "devDependencies": {
    "turbo": "^2.9.18",
    "typescript": "^6.0.3"
  }
}
